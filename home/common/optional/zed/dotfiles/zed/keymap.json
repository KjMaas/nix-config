[
  // Workspace Management
  {
    "context": "Workspace || Editor",
    "bindings": {
      // File Navigation
      "space f f": "file_finder::Toggle",
      // Pane Navigation
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      // Pane Manipulation
      "ctrl-f": "workspace::ToggleZoom",
      "ctrl-shift-h": "workspace::SwapPaneLeft",
      "ctrl-shift-l": "workspace::SwapPaneRight",
      "ctrl-shift-k": "workspace::SwapPaneUp",
      "ctrl-shift-j": "workspace::SwapPaneDown"
    }
  },
  // Pane Management
  {
    "context": "Pane",
    "bindings": {
      // Tab Navigation
      "alt-h": "pane::ActivatePreviousItem",
      "alt-l": "pane::ActivateNextItem",
      "alt-shift-h": "pane::SwapItemLeft",
      "alt-shift-l": "pane::SwapItemRight",
      // Pane Operations
      "alt-s": "pane::SplitDown",
      "alt-v": "pane::SplitRight",
      "alt-c": "pane::CloseActiveItem",
      "alt-shift-c": "pane::ReopenClosedItem",
      // Panel Focus
      "alt-t": "terminal_panel::ToggleFocus"
    }
  },
  // Terminal
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-n": [
        "terminal::SendKeystroke",
        "ctrl-n"
      ]
    }
  },
  // Vim Mode Bindings
  {
    "context": "vim_mode == insert",
    "bindings": {
      "shift j k": [
        "workspace::SendKeystrokes",
        "escape"
      ]
    }
  },
  // {
  //   "context": "VimControl && !menu",
  //   "bindings": {
  //     // navigate and select individual words in camelCase or snake_case
  //     // NOTE: these bindings have been commented out since they break commonly used bindings such as 'ciw' or 'diw'
  //     "w": "vim::NextSubwordStart",
  //     "b": "vim::PreviousSubwordStart",
  //     "e": "vim::NextSubwordEnd",
  //     "g e": "vim::PreviousSubwordEnd"
  //   }
  // },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "shift-y": ["workspace::SendKeystrokes", "y $"],
      "j": ["workspace::SendKeystrokes", "g j"],
      "k": ["workspace::SendKeystrokes", "g k"]
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "shift-s": ["vim::PushAddSurrounds", {}]
    }
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      // Motion Commands
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward",
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp"
    }
  }
]
