[
  // Workspace Management
  {
    "context": "(Pane || Dock || Editor) && vim_mode == normal",
    "bindings": {
      // File Navigation
      "space f f": "file_finder::Toggle"
    }
  },
  {
    "context": "Workspace || Editor",
    "bindings": {
      // Pane Navigation
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      // Pane Manipulation
      "ctrl-f": "workspace::ToggleZoom",
      "ctrl-shift-h": "workspace::SwapPaneLeft",
      "ctrl-shift-l": "workspace::SwapPaneRight",
      "ctrl-shift-k": "workspace::SwapPaneUp",
      "ctrl-shift-j": "workspace::SwapPaneDown",
      // Dock Focus
      "alt-e": "workspace::ToggleLeftDock", // explorer
      "alt-a": "workspace::ToggleRightDock", // assistant
      "alt-t": "workspace::ToggleBottomDock" // terminal
    }
  },
  // Pane Management (select and move tabs around)
  {
    "context": "Pane",
    "bindings": {
      // Tab Navigation
      "alt-h": "pane::ActivatePreviousItem",
      "alt-l": "pane::ActivateNextItem",
      "alt-shift-h": "pane::SwapItemLeft",
      "alt-shift-l": "pane::SwapItemRight",
      // Pane Operations
      "alt-s": "pane::SplitDown",
      "alt-v": "pane::SplitRight",
      "alt-c": "pane::CloseActiveItem",
      "alt-shift-c": "pane::ReopenClosedItem",
      "alt-q": "pane::CloseAllItems",
      "alt-shift-q": "pane::ReopenClosedItem"
    }
  },
  // Terminal
  {
    "context": "Terminal",
    "bindings": {
      "shift-enter": [
        "terminal::SendText",
        "\u001b\r"
      ]
    }
  }
]
