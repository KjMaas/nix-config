{
  // AI Assistant Configuration
  "assistant": {
    "button": true,
    "default_model": {
      "model": "claude-3-5-sonnet-latest",
      "provider": "zed.dev"
    },
    "default_open_ai_model": null,
    "default_width": 480,
    "dock": "right",
    "enabled": true,
    "inline_alternatives": [
      {
        "model": "claude-3-5-sonnet-latest",
        "provider": "zed.dev"
      }
    ],
    "version": "2"
  },
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434",
      "available_models": [
        {
          "display_name": "codellama",
          "max_tokens": 32768,
          "name": "codellama:7b"
        }
      ]
    }
  },
  "edit_predictions": {
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_assistant": false
  },

  // Editor UI and Display
  "theme": {
    "dark": "One Dark",
    "light": "One Light",
    "mode": "dark"
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "hour_format": "hour24",
  "show_whitespaces": "selection",
  "wrap_guides": [80],
  "soft_wrap": "bounded",
  "cursor_blink": false,

  // Editor Panes and Navigation
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
    "activate_on_close": "history",
    "show_close_button": "hover",
    "show_diagnostics": "all",
    "show_file_status": true
  },
  "scrollbar": {
    "show": "never",
    "cursors": true,
    "git_diff": true,
    "search_results": true,
    "selected_text": true,
    "selected_symbol": true,
    "diagnostics": "all",
    "axes": {
      "horizontal": true,
      "vertical": true
    }
  },
  "file_finder": {
    "modal_max_width": "medium"
  },
  "active_pane_modifiers": {
    "magnification": 1.0,
    "border_size": 3,
    "inactive_opacity": 0.8
  },
  "project_panel": {
    "default_width": 350
  },

  // Development Tools and Extensions
  "auto_install_extensions": {
    "nix": true,
    "lua": true,
    "rust": true,
    "toml": true,
    "vue": true
  },

  "languages": {
    "Nix": {
      "language_servers": ["nixd", "!nil"],
      "formatter": {
        "external": {
          "command": "nixfmt",
          "arguments": ["--quiet", "--"]
        }
      }
    }
  },
  "lsp": {
    "nix": {
      "binary": {
        "path_lookup": true
      }
    },
    "rust-analyzer": {
      "binary": {
        "path_lookup": true
      }
    }
  },

  "node": {
    "npm_path": "/nix/store/wfxq6w9bkp5dcfr8yb6789b0w7128gnb-nodejs-20.18.1/bin/npm",
    "path": "/nix/store/wfxq6w9bkp5dcfr8yb6789b0w7128gnb-nodejs-20.18.1/bin/node"
  },
  "load_direnv": "shell_hook",

  // Terminal Configuration
  "terminal": {
    "alternate_scroll": "off",
    "blinking": "off",
    "button": false,
    "copy_on_select": false,
    "detect_venv": {
      "on": {
        "activate_script": "default",
        "directories": [".env", "env", ".venv", "venv"]
      }
    },
    "dock": "bottom",
    "env": {
      "TERM": "zsh"
    },
    "font_family": "FiraCode Nerd Font",
    "font_features": null,
    "font_size": null,
    "line_height": "comfortable",
    "option_as_meta": false,
    "shell": "system",
    "toolbar": {
      "title": true
    },
    "working_directory": "current_project_directory"
  },

  // Git Integration
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true
    },
    "hunk_style": "staged_hollow"
  },

  // Vim Mode Settings
  "vim_mode": true,
  "use_smartcase_search": true,
  "vim": {
    "default_mode": "normal",
    "use_system_clipboard": "always",
    "use_multiline_find": true,
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
    "highlight_on_yank_duration": 50
  },

  // General Settings
  "auto_update": false,
  "base_keymap": "VSCode",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
